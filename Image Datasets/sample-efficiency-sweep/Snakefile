"""Eight methods, four patient fractions, four datasets, ten held-out folds."""
from pathlib import Path
import sys

BASE = Path(workflow.basedir)
sys.path.insert(0, str(BASE))
from support import conditions, immutable_json, resolve_config

configfile: 'sweep.yaml'
CFG = resolve_config(config, BASE)
PROJECT = Path(CFG['project_dir'])
sys.path.insert(0, str(PROJECT / 'comparison-sweep'))
from design import source_files

ROOT = Path(CFG['results_dir']) / CFG['run_name']
RESOLVED = str(ROOT / 'sweep.resolved.json')
immutable_json(RESOLVED, CFG)
CONDITIONS = conditions(CFG)
MANIFEST = str(ROOT / 'manifest.json')
PYTHON = CFG['python']
RUNNER = str(BASE / 'run.py')
CODE = [str(p) for folder in (BASE, PROJECT / 'comparison-sweep') for p in folder.glob('*.py')
        if not p.name.startswith('test_')]
SHARED = [str(PROJECT / n) for n in ('train.py', 'configuration.py', 'datasets.py', 'models.py',
          'pretraining.py', 'training_options.py', 'utils.py', 'imaging.py', 'transforms.py', 'baselines.py')]
MARKERS = expand(str(ROOT / 'completed/{condition}/{method}/complete.json'),
                 condition=list(CONDITIONS), method=CFG['methods'])
PREDICTIONS = expand(str(ROOT / 'runs/{condition}/{method}/predictions.csv'),
                     condition=list(CONDITIONS), method=CFG['methods'])
FOLD_METRICS = expand(str(ROOT / 'runs/{condition}/{method}/fold_metrics.csv'),
                      condition=list(CONDITIONS), method=CFG['methods'])

shell.executable('/bin/bash')
shell.prefix('module load anaconda3/2023.09-0; source activate snakemake-slurm; ')


def features(wildcards):
    if wildcards.method not in ('dtfd_afs', 'clam'):
        return []
    directory = ROOT / 'features' / CONDITIONS[wildcards.condition]['dataset']
    return [str(directory / 'features.npy'), str(directory / 'complete.json')]


wildcard_constraints:
    condition='|'.join(CONDITIONS), method='|'.join(CFG['methods']),
    dataset='|'.join('medical_'+d for d in CFG['medical_datasets'])


rule all:
    input:
        str(ROOT / 'summary.csv'), str(ROOT / 'fold_metrics.csv'), str(ROOT / 'predictions.csv')


localrules: summarize


rule prepare:
    input:
        cfg=RESOLVED, code=CODE, shared=SHARED,
        sources=([str(Path(CFG['results_dir']) / CFG['source_run'] / name) for name in
                  ('manifest.json', 'subset_counts.csv', 'sweep.resolved.json')] if CFG.get('source_run')
                 else source_files(dict(CFG, experiments=['medical'])))
    output:
        manifest=MANIFEST, counts=str(ROOT / 'subset_counts.csv'), report=str(ROOT / 'preparation_report.json')
    threads: 1
    resources:
        mem_mb=CFG['mem_mb'], runtime=CFG['runtime_minutes'], gpu=0
    log:
        str(ROOT / 'logs/prepare.log')
    shell:
        '{PYTHON:q} -u {RUNNER:q} prepare --config {input.cfg:q} > {log:q} 2>&1'


rule extract_features:
    input:
        manifest=MANIFEST, cfg=RESOLVED, code=CODE, shared=SHARED
    output:
        str(ROOT / 'features/{dataset}/features.npy'), str(ROOT / 'features/{dataset}/complete.json')
    threads: CFG['cpus']
    resources:
        mem_mb=CFG['mem_mb'], runtime=CFG['runtime_minutes'], gpu=1
    log:
        str(ROOT / 'logs/features/{dataset}.log')
    shell:
        '{PYTHON:q} -u {RUNNER:q} extract --config {input.cfg:q} --dataset {wildcards.dataset:q} > {log:q} 2>&1'


rule train_folds:
    input:
        manifest=MANIFEST, cfg=RESOLVED, code=CODE, shared=SHARED, features=features
    output:
        marker=str(ROOT / 'completed/{condition}/{method}/complete.json'),
        predictions=str(ROOT / 'runs/{condition}/{method}/predictions.csv'),
        metrics=str(ROOT / 'runs/{condition}/{method}/fold_metrics.csv')
    threads: CFG['cpus']
    resources:
        mem_mb=CFG['mem_mb'], runtime=CFG['runtime_minutes'], gpu=1
    log:
        str(ROOT / 'logs/{condition}/{method}/all_folds.log')
    shell:
        '{PYTHON:q} -u {RUNNER:q} train-all --config {input.cfg:q} --condition {wildcards.condition:q} '
        '--method {wildcards.method:q} > {log:q} 2>&1'


rule summarize:
    input:
        markers=MARKERS, predictions=PREDICTIONS, folds=FOLD_METRICS, cfg=RESOLVED, code=CODE
    output:
        str(ROOT / 'summary.csv'), str(ROOT / 'fold_metrics.csv'), str(ROOT / 'predictions.csv')
    shell:
        '{PYTHON:q} {RUNNER:q} summarize --config {input.cfg:q}'
